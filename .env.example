OPENAI_API_KEY=
# Matches the code default (src/lib/ai-actions.ts). Reasoning effort applies to gpt-5* models;
# override with OPENAI_REASONING_EFFORT (none|minimal|low|medium|high|xhigh).
OPENAI_MODEL=gpt-5.5
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_RETRIES=1

# Local Postgres from docker-compose.yml.
DATABASE_URL=postgres://ex3cuusion:ex3cuusion@127.0.0.1:54329/ex3cuusion

# State storage. Unset (default) = durable JSON file at .data/state.json — survives restarts,
# zero config. "postgres" = the durable V1 production path. "memory" = throwaway in-process
# state (what eval/e2e harnesses use; also the old pre-default behavior).
EX3CUUSION_STATE_REPOSITORY=

# Optional local-user override for isolated Postgres state. Must be a UUID.
EX3CUUSION_LOCAL_USER_ID=00000000-0000-0000-0000-000000000001

# Optional explicit JSON-file path for the file repository (overrides the .data/ default).
EX3CUUSION_STATE_FILE=

# Use fixture AI responses for deterministic local runs.
EX3CUUSION_AI_MODE=
