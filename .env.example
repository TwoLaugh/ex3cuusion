OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_RETRIES=1

# Local Postgres from docker-compose.yml.
DATABASE_URL=postgres://ex3cuusion:ex3cuusion@127.0.0.1:54329/ex3cuusion

# Keep unset for in-memory development. Set to "postgres" for the durable V1 path.
EX3CUUSION_STATE_REPOSITORY=
EX3CUUSION_STATE_SNAPSHOT_ID=local

# Optional JSON-file repository for debugging local state without Postgres.
EX3CUUSION_STATE_FILE=

# Use fixture AI responses for deterministic local runs.
EX3CUUSION_AI_MODE=
