        android:pathData="M50.8,27 L50.5,21.4 L51.6,21 L51.9,24 L52.5,20.2 L53.6,20 L53.9,23.6 L54.8,20 L55.9,20.2 L55.9,24 L56.7,20.9 L57.7,21.4 L57.4,27 L54,28.6 Z"/>
