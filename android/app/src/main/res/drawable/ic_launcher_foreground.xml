                          M65.26,60.5 m-13,0 a13,13 0 1,1 26,0 a13,13 0 1,1 -26,0
                          M54,67 m-13,0 a13,13 0 1,1 26,0 a13,13 0 1,1 -26,0
                          M42.74,60.5 m-13,0 a13,13 0 1,1 26,0 a13,13 0 1,1 -26,0
                          M42.74,47.5 m-13,0 a13,13 0 1,1 26,0 a13,13 0 1,1 -26,0"
        android:strokeColor="#E0683A" android:strokeWidth="2.1" android:fillColor="#00000000"/>

    <!-- today, the centre -->
    <path
        android:pathData="M54,54 m-13,0 a13,13 0 1,1 26,0 a13,13 0 1,1 -26,0"
