        android:pathData="M54,23.9 a30.1,30.1 0 1,1 -0.02,0 Z M54,27.1 a26.9,26.9 0 1,0 0.02,0 Z"
        android:fillType="evenOdd">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="54" android:startY="23.9"
                android:endX="54" android:endY="84.1"
                android:startColor="#2FB054" android:endColor="#0E8A43"/>
        </aapt:attr>
    </path>

    <!-- clasped hands / fingers crossing the ring top -->
